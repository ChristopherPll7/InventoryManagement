            "url": "{{baseUrl}}/api/products/{{productId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated product\",\n  \"description\": \"Acceptance test\",\n  \"sku\": \"PM-{{runId}}\",\n  \"price\": 15.25,\n  \"categoryId\": \"{{categoryId}}\"\n}",
              "options": {
