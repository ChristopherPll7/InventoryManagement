                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"name\", () => { pm.expect(data.name).to.eql(\"Updated product\"); });pm.test(\"price\", () => { pm.expect(data.price).to.eql(15.25); });pm.test(\"currentStock\", () => { pm.expect(data.currentStock).to.eql(0); });"
                ]
              }
            }
          ]
        },
        {
