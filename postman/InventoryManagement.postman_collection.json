{
  "info": {
    "name": "Inventory Management - Acceptance",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run all folders in order, one iteration, with the Local environment and a fresh adminInventory accessToken obtained through Swagger. Creates one category, one product and two movements; deactivates the category/product without physically deleting history. The optional 403 case requires a separate valid restrictedAccessToken. See postman/README.md."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "runId",
      "value": "",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "missingId",
      "value": "",
      "type": "string"
    },
    {
      "key": "entryDate",
      "value": "",
      "type": "string"
    },
    {
      "key": "firstMovementId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Setup and categories",
      "item": [
        {
          "name": "01 Health and initialize run",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runId\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"missingId\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "[\"categoryId\", \"productId\", \"entryDate\"].forEach(key => pm.collectionVariables.unset(key));",
                  "if (!pm.environment.get(\"accessToken\")) { throw new Error(\"Set accessToken in the selected local environment before running.\"); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"status\", () => { pm.expect(data.status).to.eql(\"healthy\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Create category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman {{runId}}\",\n  \"description\": \"Postman acceptance test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.test(\"Resource created\", () => { pm.expect(data.id).to.match(/^[0-9a-f-]{36}$/i); pm.collectionVariables.set(\"categoryId\", data.id); pm.expect(pm.response.headers.get(\"Location\")).to.include(data.id); });"
                ]
              }
            }
          ]
        },
        {
          "name": "03 List categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"Created category is listed\", () => { pm.expect(data.some(x => x.id === pm.collectionVariables.get(\"categoryId\"))).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Get category",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categories/{{categoryId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"isActive\", () => { pm.expect(data.isActive).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Update category",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/categories/{{categoryId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman {{runId}}\",\n  \"description\": \"Updated by Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"description\", () => { pm.expect(data.description).to.eql(\"Updated by Postman\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Duplicate category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman {{runId}}\",\n  \"description\": \"Postman acceptance test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
                  "const data = pm.response.json();",
                  "pm.test(\"Error envelope\", () => { pm.expect(data.code).to.be.a(\"string\").and.not.empty; pm.expect(data.message).to.be.a(\"string\").and.not.empty; pm.expect(data.code).to.eql(\"DUPLICATE_CATEGORY_NAME\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Invalid category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"description\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
                  "const data = pm.response.json();",
                  "pm.test(\"Error envelope\", () => { pm.expect(data.code).to.be.a(\"string\").and.not.empty; pm.expect(data.message).to.be.a(\"string\").and.not.empty;  });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
