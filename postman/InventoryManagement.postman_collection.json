    },
    {
      "name": "03 - Inventory and history",
      "item": [
        {
          "name": "16 Empty history",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/inventory/products/{{productId}}/movements"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"totalCount\", () => { pm.expect(data.totalCount).to.eql(0); });pm.test(\"items\", () => { pm.expect(data.items).to.eql([]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "17 Register entry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/inventory/movements",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"type\": \"Entry\",\n  \"quantity\": 10,\n  \"reason\": \"Postman acceptance test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();"
                ]
              }
            }
          ]
        },
        {
          "name": "18 Register exit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/inventory/movements",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"type\": \"Exit\",\n  \"quantity\": 3,\n  \"reason\": \"Postman acceptance test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();"
                ]
              }
            }
          ]
        },
        {
          "name": "19 Balance equals seven",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/inventory/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"currentStock\", () => { pm.expect(data.currentStock).to.eql(7); });"
                ]
              }
            }
          ]
        },
        {
          "name": "20 Reject insufficient stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/inventory/movements",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"type\": \"Exit\",\n  \"quantity\": 8,\n  \"reason\": \"Postman acceptance test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
                  "const data = pm.response.json();",
                  "pm.test(\"Error envelope\", () => { pm.expect(data.code).to.be.a(\"string\").and.not.empty; pm.expect(data.message).to.be.a(\"string\").and.not.empty; pm.expect(data.code).to.eql(\"INSUFFICIENT_STOCK\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "21 Reject zero quantity",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/inventory/movements",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"type\": \"Entry\",\n  \"quantity\": 0,\n  \"reason\": \"Postman acceptance test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
                  "const data = pm.response.json();",
                  "pm.test(\"Error envelope\", () => { pm.expect(data.code).to.be.a(\"string\").and.not.empty; pm.expect(data.message).to.be.a(\"string\").and.not.empty;  });"
                ]
              }
            }
          ]
        },
        {
          "name": "22 Reject numeric movement type",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/inventory/movements",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"type\": 1,\n  \"quantity\": 1,\n  \"reason\": \"Postman acceptance test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
                  "const data = pm.response.json();",
                  "pm.test(\"Error envelope\", () => { pm.expect(data.code).to.be.a(\"string\").and.not.empty; pm.expect(data.message).to.be.a(\"string\").and.not.empty;  });"
                ]
              }
            }
          ]
        },
        {
          "name": "23 History contains only successful movements",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/inventory/products/{{productId}}/movements?page=1&pageSize=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"totalCount\", () => { pm.expect(data.totalCount).to.eql(2); });pm.test(\"items.length\", () => { pm.expect(data.items.length).to.eql(2); });pm.test(\"Stock matches history\", () => { pm.expect(data.items.reduce((sum, x) => sum + (x.type === \"Entry\" ? x.quantity : -x.quantity), 0)).to.eql(7); });pm.test(\"Newest timestamps first\", () => { pm.expect(Date.parse(data.items[0].createdAt)).to.be.at.least(Date.parse(data.items[1].createdAt)); });pm.collectionVariables.set(\"entryDate\", encodeURIComponent(data.items.find(x => x.type === \"Entry\").createdAt));"
                ]
              }
            }
          ]
        },
        {
          "name": "24 Entry filter and inclusive date bounds",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/inventory/products/{{productId}}/movements?type=Entry&startDate={{entryDate}}&endDate={{entryDate}}&page=1&pageSize=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"totalCount\", () => { pm.expect(data.totalCount).to.eql(1); });pm.test(\"items.length\", () => { pm.expect(data.items.length).to.eql(1); });pm.test(\"items[0].type\", () => { pm.expect(data.items[0].type).to.eql(\"Entry\"); });"
                ]
              }
            }
          ]
        },
