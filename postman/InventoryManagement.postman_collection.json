            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman product\",\n  \"description\": \"Acceptance test\",\n  \"sku\": \"PM-{{runId}}\",\n  \"price\": 12.5,\n  \"categoryId\": \"{{categoryId}}\"\n}",
              "options": {
