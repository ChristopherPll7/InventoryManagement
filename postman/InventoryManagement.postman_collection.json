                  "const data = pm.response.json();",
                  "pm.test(\"currentStock\", () => { pm.expect(data.currentStock).to.eql(0); });pm.test(\"categoryId\", () => { pm.expect(data.categoryId).to.eql(pm.collectionVariables.get(\"categoryId\")); });"
                ]
              }
            }
          ]
        },
        {
